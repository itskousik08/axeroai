---
import MainLayout from '../../layouts/MainLayout.astro';
import PremiumCard from '../../components/PremiumCard';
import IconRenderer from '../../components/IconRenderer';
import projectsData from '../../data/projects.json';
import { ChevronLeft, ExternalLink, Globe, Github, Share2 } from 'lucide-react';

export function getStaticPaths() {
  return projectsData.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Related projects (same category or others)
const relatedProjects = projectsData
  .filter(p => p.slug !== project.slug && (p.category === project.category || p.featured))
  .slice(0, 2);
---

<MainLayout title={`${project.title} | AxeroAI`} description={project.shortDescription}>
  <main class="relative bg-background pt-32 pb-40">
    <!-- Back Button -->
    <div class="max-w-7xl mx-auto px-6 md:px-10 mb-12">
      <a href="/projects" class="group flex items-center gap-2 text-on-surface-muted hover:text-white transition-colors text-sm font-mono uppercase tracking-widest">
        <ChevronLeft size={16} className="transition-transform group-hover:-translate-x-1" />
        Back to Fleet
      </a>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="grid lg:grid-cols-12 gap-16">
        <!-- Main Content -->
        <div class="lg:col-span-8 space-y-16">
          <header class="space-y-8">
            <div class="flex items-center gap-6">
              <div class="w-20 h-20 rounded-3xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
                <IconRenderer client:load iconName={project.iconName} size={40} />
              </div>
              <div class="space-y-2">
                <div class="flex items-center gap-4">
                  <span class="text-xs font-mono text-primary uppercase tracking-[0.2em]">{project.category}</span>
                  <span class="w-1 h-1 bg-outline rounded-full"></span>
                  <span class="text-xs font-mono text-on-surface-muted uppercase">{project.status}</span>
                </div>
                <h1 class="text-5xl md:text-7xl font-extrabold tracking-tighter">{project.title}</h1>
              </div>
            </div>

            <p class="text-2xl text-on-surface-variant font-light leading-relaxed max-w-3xl">
              {project.shortDescription}
            </p>
          </header>

          <div class="prose prose-invert prose-lg max-w-none">
            <h2 class="text-white">Overview</h2>
            <p class="text-on-surface-variant">
              {project.fullDescription}
            </p>
            
            <div class="grid md:grid-cols-2 gap-8 my-16">
              <div class="p-8 border border-outline bg-surface/30 rounded-2xl">
                <h3 class="text-white text-xl mb-4 mt-0">Technical Stack</h3>
                <div class="flex flex-wrap gap-3">
                  {project.tags.map(tag => (
                    <span class="px-4 py-2 bg-background border border-outline rounded-xl font-mono text-xs text-primary">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <div class="p-8 border border-outline bg-surface/30 rounded-2xl">
                <h3 class="text-white text-xl mb-4 mt-0">Deployment Details</h3>
                <ul class="space-y-3 m-0 p-0 list-none text-sm text-on-surface-variant">
                  <li class="flex justify-between border-b border-outline/50 pb-2">
                    <span class="font-mono uppercase opacity-50">Release Date</span>
                    <span>{new Date(project.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</span>
                  </li>
                  <li class="flex justify-between border-b border-outline/50 pb-2">
                    <span class="font-mono uppercase opacity-50">Current Status</span>
                    <span class="text-primary">{project.status}</span>
                  </li>
                   <li class="flex justify-between">
                    <span class="font-mono uppercase opacity-50">Category</span>
                    <span>{project.category}</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap gap-6 pt-8">
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="premium-button premium-button-primary px-10 py-5 flex items-center gap-3 text-lg">
              Access Live Node <ExternalLink size={20} />
            </a>
            <button class="p-5 border border-outline rounded-2xl text-on-surface-variant hover:text-white hover:border-white transition-all">
              <Share2 size={24} />
            </button>
          </div>
        </div>

        <!-- Sidebar / Related -->
        <div class="lg:col-span-4 space-y-12">
          <div class="sticky top-32">
            <h3 class="text-xs font-mono text-on-surface-muted uppercase tracking-[0.3em] mb-8">Related Projects</h3>
            <div class="space-y-6">
              {relatedProjects.map(p => (
                <a href={`/projects/${p.slug}`} class="group block">
                  <PremiumCard client:visible className="p-6 transition-transform group-hover:-translate-y-1">
                    <div class="flex items-start gap-4">
                      <div class="w-12 h-12 rounded-xl bg-surface-accent flex items-center justify-center text-primary shrink-0 border border-outline">
                         <IconRenderer client:load iconName={p.iconName} size={24} />
                      </div>
                      <div>
                        <h4 class="font-bold text-lg group-hover:text-primary transition-colors">{p.title}</h4>
                        <p class="text-sm text-on-surface-variant line-clamp-2 mt-1">{p.shortDescription}</p>
                      </div>
                    </div>
                  </PremiumCard>
                </a>
              ))}
            </div>

            <div class="mt-16 p-8 rounded-3xl bg-primary/5 border border-primary/20 space-y-6 relative overflow-hidden">
               <div class="absolute top-0 right-0 p-4 opacity-10">
                  <Globe size={80} />
               </div>
               <h3 class="text-xl font-bold relative z-10">Interested in this architecture?</h3>
               <p class="text-on-surface-variant text-sm relative z-10">
                  We specialize in custom enterprise solutions. Contact our engineering team for integration details.
               </p>
               <a href="/contact" class="flex items-center justify-center w-full py-4 border border-primary text-primary font-bold uppercase tracking-widest text-xs hover:bg-primary hover:text-white transition-all rounded-xl relative z-10">
                  Inquire Now
               </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</MainLayout>
