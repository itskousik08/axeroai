---
import MainLayout from '../../layouts/MainLayout.astro';
import newsData from '../../content/news/news.json';
import { Calendar, Tag, ChevronLeft, Clock, Share2, Globe, Heart } from 'lucide-react';

export async function getStaticPaths() {
  return newsData.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;

// Related news
const relatedNews = newsData
  .filter(n => n.slug !== entry.slug)
  .slice(0, 2);

const formatDate = (dateStr) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric'
  });
};

// Import HTML content string natively in Astro
// We can use compile-time glob to find the right file or just use a dynamic import if it's treated as a module, 
// but since it's .html, we can use import.meta.glob with { as: 'raw' }
const articles = import.meta.glob('../../content/news/articles/*.html', { as: 'raw', eager: true });
const htmlContent = articles[`../../content/news/articles/${entry.htmlFile}`];
---

<MainLayout title={entry.title} description={entry.excerpt}>
  <div class="relative bg-background min-h-screen">
    <!-- Background Accents -->
    <div class="absolute top-0 right-0 w-1/3 h-1/2 bg-primary/5 blur-[120px] pointer-events-none"></div>
    
    <article class="relative z-10 pt-32 pb-40">
      <div class="max-w-4xl mx-auto px-6">
        <!-- Breadcrumb / Back -->
        <div class="mb-12">
          <a href="/news" class="group inline-flex items-center gap-2 text-on-surface-muted hover:text-primary transition-colors text-sm font-mono uppercase tracking-widest">
            <ChevronLeft size={16} class="transition-transform group-hover:-translate-x-1" />
            Newsroom
          </a>
        </div>

        <!-- Header -->
        <header class="space-y-8 mb-16">
          <div class="flex items-center gap-4 text-xs font-mono uppercase tracking-[0.2em]">
            <span class="text-primary">{entry.category}</span>
            <span class="text-on-surface-muted">•</span>
            <span class="text-on-surface-muted">{formatDate(entry.date)}</span>
          </div>
          
          <h1 class="text-4xl md:text-6xl font-bold leading-tight tracking-tight">
            {entry.title}
          </h1>

          <p class="text-xl md:text-2xl text-on-surface-variant font-light leading-relaxed italic">
            {entry.excerpt}
          </p>

          {entry.image ? (
            <div class="aspect-[21/9] rounded-2xl overflow-hidden border border-outline bg-surface mt-12">
              <img src={entry.image} alt={entry.title} class="w-full h-full object-cover" />
            </div>
          ) : (
            <div class="mt-12 h-1 bg-outline border-none"></div>
          )}
        </header>

        <!-- Content -->
        <div class="prose prose-invert prose-lg max-w-none 
          prose-headings:text-white 
          prose-p:text-on-surface-variant prose-p:leading-relaxed 
          prose-strong:text-white 
          prose-blockquote:border-primary prose-blockquote:bg-surface/30 prose-blockquote:p-6 prose-blockquote:rounded-xl
          prose-ul:list-disc prose-ul:pl-6 prose-li:mb-2
          prose-a:text-primary hover:prose-a:underline">
          <Fragment set:html={htmlContent} />
        </div>

        <!-- Tags -->
        <div class="mt-16 flex flex-wrap gap-2">
          {entry.tags.map(tag => (
            <span class="px-3 py-1 bg-surface border border-outline rounded-full text-xs font-mono text-on-surface-muted">
              #{tag}
            </span>
          ))}
        </div>

        <hr class="my-20 border-outline" />

        <!-- Related Posts -->
        <section class="space-y-12">
          <h2 class="text-2xl font-bold">Related Intelligence</h2>
          <div class="grid md:grid-cols-2 gap-8">
            {relatedNews.map(item => (
              <a href={`/news/${item.slug}`} class="group block space-y-4">
                <div class="aspect-video rounded-xl overflow-hidden border border-outline bg-surface">
                  <img src={item.image} alt={item.title} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
                </div>
                <div class="space-y-2">
                  <div class="text-[10px] font-mono text-primary uppercase tracking-widest">{item.category}</div>
                  <h3 class="text-lg font-bold group-hover:text-primary transition-colors">{item.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>
    </article>
  </div>
</MainLayout>
