---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { ChevronRight, Calendar, Tag, Clock } from 'lucide-react';

const newsEntries = await getCollection('news');
const newsItems = newsEntries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<MainLayout title="News" description="The latest updates and insights from the team at AXEROAI. Explore our AI research and model releases.">
  <section class="pt-32 pb-20 bg-white dark:bg-[#0B0F14]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16">
        <h1 class="text-5xl font-bold text-gray-900 dark:text-[#F9FAFB] mb-6 tracking-tight">News & Research</h1>
        <p class="text-xl text-gray-600 dark:text-[#9CA3AF] leading-relaxed">
          Deep dives into AI research, model releases, and our mission to build safe intelligence.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        {newsItems.map((item) => (
          <article class="group flex flex-col">
            <a href={`/news/${item.id}`} class="block aspect-[16/9] mb-6 overflow-hidden rounded-2xl border border-gray-200 dark:border-[#1F2937]">
              <img 
                src={item.data.image} 
                alt={`Featured image for ${item.data.title}`} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                referrerPolicy="no-referrer"
              />
            </a>
            <div class="flex items-center space-x-4 mb-4 text-xs text-gray-500 dark:text-[#6B7280]">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#4F46E5]/10 text-[#4F46E5] border border-[#4F46E5]/20">
                <Tag className="w-3 h-3 mr-1" aria-hidden="true" />
                {item.data.category}
              </span>
              <span class="flex items-center">
                <Calendar className="w-3 h-3 mr-1" aria-hidden="true" />
                {item.data.date}
              </span>
              {item.data.readTime && (
                <span class="flex items-center">
                  <Clock className="w-3 h-3 mr-1" aria-hidden="true" />
                  {item.data.readTime}
                </span>
              )}
            </div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-[#F9FAFB] mb-4 group-hover:text-[#4F46E5] transition-colors">
              <a href={`/news/${item.id}`}>{item.data.title}</a>
            </h2>
            <p class="text-gray-600 dark:text-[#9CA3AF] mb-4 leading-relaxed">
              {item.data.description}
            </p>
            <div class="flex items-center justify-between mt-auto">
              <div class="flex items-center space-x-2">
                {item.data.author && (
                  <>
                    <div class="w-8 h-8 rounded-full bg-gray-100 dark:bg-[#1F2937] flex items-center justify-center text-xs font-bold text-gray-900 dark:text-[#F9FAFB]">
                      {item.data.author.split(' ').map(n => n[0]).join('')}
                    </div>
                    <span class="text-sm font-medium text-gray-900 dark:text-[#F9FAFB]">{item.data.author}</span>
                  </>
                )}
              </div>
              <a href={`/news/${item.id}`} class="text-[#4F46E5] font-semibold flex items-center group-hover:translate-x-1 transition-transform" aria-label={`Read more about ${item.data.title}`}>
                Read more <ChevronRight className="ml-1 w-4 h-4" aria-hidden="true" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
