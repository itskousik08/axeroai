---
import MainLayout from '../../layouts/MainLayout.astro';
import researchData from '../../content/research/research.json';
import { Calendar, Tag, ChevronLeft, Clock, Share2, Globe, Bookmark, Download } from 'lucide-react';

export async function getStaticPaths() {
  return researchData.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;

// Related research
const relatedResearch = researchData
  .filter(r => r.slug !== entry.slug)
  .slice(0, 2);

const formatDate = (dateStr) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric'
  });
};

// Import HTML content string natively in Astro
const articles = import.meta.glob('../../content/research/articles/*.html', { as: 'raw', eager: true });
const htmlContent = articles[`../../content/research/articles/${entry.htmlFile}`];
---

<MainLayout title={entry.title} description={entry.excerpt}>
  <div class="relative bg-background min-h-screen">
    <!-- Background Accents -->
    <div class="absolute top-0 left-0 w-1/3 h-1/2 bg-primary/2 blur-[120px] pointer-events-none"></div>
    
    <article class="relative z-10 pt-32 pb-40">
      <div class="max-w-5xl mx-auto px-6">
        <!-- Breadcrumb / Back -->
        <div class="mb-12">
          <a href="/research" class="group inline-flex items-center gap-2 text-on-surface-muted hover:text-primary transition-colors text-sm font-mono uppercase tracking-widest">
            <ChevronLeft size={16} class="transition-transform group-hover:-translate-x-1" />
            Back to Research
          </a>
        </div>

        <div class="grid lg:grid-cols-12 gap-16">
          <div class="lg:col-span-8">
            <!-- Header -->
            <header class="space-y-8 mb-16">
              <div class="flex items-center gap-4 text-[10px] font-mono uppercase tracking-[0.3em]">
                <span class="text-primary">{entry.category}</span>
                <span class="text-on-surface-muted">•</span>
                <span class="text-on-surface-muted">{formatDate(entry.date)}</span>
              </div>
              
              <h1 class="text-4xl md:text-6xl font-bold leading-[1.1] tracking-tight">
                {entry.title}
              </h1>

              <p class="text-xl text-on-surface-variant font-light leading-relaxed">
                {entry.excerpt}
              </p>

              {entry.image ? (
                <div class="aspect-video rounded-[2rem] overflow-hidden border border-outline bg-surface mt-12 relative group shadow-2xl">
                  <img src={entry.image} alt={entry.title} class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000" />
                </div>
              ) : (
                <div class="mt-12 h-px bg-outline"></div>
              )}
            </header>

            <!-- Metadata for Research -->
            <div class="flex flex-wrap items-center gap-8 py-6 border-y border-outline mb-16 text-sm font-mono uppercase tracking-widest text-on-surface-muted">
               <div class="flex items-center gap-2">
                 <Clock size={14} />
                 <span>15 min read</span>
               </div>
               <div class="flex items-center gap-2">
                 <Globe size={14} />
                 <span>Open Access</span>
               </div>
            </div>

            <!-- Content -->
            <div class="prose prose-invert prose-lg max-w-none 
              prose-headings:text-white 
              prose-p:text-on-surface-variant prose-p:leading-relaxed 
              prose-strong:text-white 
              prose-blockquote:border-primary prose-blockquote:italic prose-blockquote:font-light prose-blockquote:bg-surface/20 prose-blockquote:p-6 prose-blockquote:rounded-xl
              prose-pre:bg-surface prose-pre:border prose-pre:border-outline
              prose-ul:list-disc prose-ul:pl-6 prose-li:mb-2
              prose-a:text-primary hover:prose-a:underline">
              <Fragment set:html={htmlContent} />
            </div>

            <!-- Tags -->
            <div class="mt-16 flex flex-wrap gap-2">
              {entry.tags.map(tag => (
                <span class="px-4 py-1.5 bg-surface border border-outline rounded-lg text-[10px] font-mono text-on-surface-muted uppercase tracking-widest">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap gap-4 mt-16 pt-8 border-t border-outline">
              <button class="premium-button premium-button-primary px-8">
                Download PDF
                <Download size={18} />
              </button>
              <button class="premium-button premium-button-secondary">
                <Share2 size={18} />
              </button>
            </div>
          </div>

          <!-- Sidebar for related research -->
          <aside class="lg:col-span-4 space-y-12">
            <div class="sticky top-32 space-y-8">
              <h3 class="text-[10px] font-mono text-on-surface-muted uppercase tracking-[0.3em]">Related Publications</h3>
              <div class="space-y-8">
                {relatedResearch.map(item => (
                  <a href={`/research/${item.slug}`} class="group block space-y-4">
                    <div class="space-y-2">
                      <div class="text-[9px] font-mono text-primary uppercase tracking-widest">{item.category} <span class="mx-1">•</span> {formatDate(item.date)}</div>
                      <h4 class="text-lg font-bold group-hover:text-primary transition-colors leading-snug">{item.title}</h4>
                    </div>
                  </a>
                ))}
              </div>

               <div class="bg-surface border border-outline p-8 rounded-3xl space-y-6">
                <h3 class="text-xl font-bold">Research Updates</h3>
                <p class="text-sm text-on-surface-variant font-light leading-relaxed">
                  Join our research mailing list to receive notifications about new publications and model releases.
                </p>
                <button class="w-full premium-button premium-button-secondary text-xs uppercase tracking-widest font-bold">
                  Subscribe
                </button>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </article>
  </div>
</MainLayout>
