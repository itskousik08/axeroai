---
import MainLayout from '../../layouts/MainLayout.astro';
import researchData from '../../content/research/research.json';
import { Search, ArrowRight, ArrowUpRight, BookOpen, Users, Brain, ShieldCheck, Microscope } from 'lucide-react';

const teams = [
  { name: 'Interpretability', description: 'The mission of the Interpretability team is to discover and understand how large language models work internally.' , icon: Brain},
  { name: 'Alignment', description: 'The Alignment team works to understand the risks of AI models and develop ways to ensure that future ones remain helpful, honest, and harmless.', icon: ShieldCheck },
  { name: 'Safety', description: 'Exploring the boundaries of model behavior to identify and mitigate potential risks and adversarial vulnerabilities.', icon: Users },
  { name: 'Frontier Science', description: 'Applying model capabilities to accelerate scientific discovery in physics, chemistry, and biology.', icon: Microscope }
];

const featuredResearch = researchData[0];
const publications = researchData;
---

<MainLayout title="Research" description="Our research teams investigate the safety, inner workings, and societal impacts of AI models.">
  <div class="relative min-h-screen bg-background">
     <!-- Atmospheric Background -->
    <div class="absolute inset-0 bg-background">
      <div class="absolute top-0 right-0 w-[60%] h-[40%] bg-primary/2 blur-[120px] rounded-full"></div>
    </div>

    <main class="relative z-10 pt-32 pb-24 max-w-5xl mx-auto px-6 lg:px-8">
      <!-- Hero -->
      <section class="space-y-12 mb-24">
        <div>
          <h1 class="text-6xl md:text-7xl font-bold tracking-tight mb-8">Research</h1>
          <p class="text-2xl text-on-surface-variant leading-relaxed max-w-3xl font-light">
            Our research teams investigate the safety, inner workings, and societal impacts of AI models – so that artificial intelligence has a positive impact as it becomes increasingly capable.
          </p>
        </div>

        <div class="flex flex-wrap gap-x-8 gap-y-4 items-center">
          <span class="text-sm font-mono uppercase tracking-widest text-on-surface-muted">Research teams:</span>
          {teams.map(team => (
            <a href={`#${team.name.toLowerCase()}`} class="text-on-surface hover:text-primary transition-colors border-b border-on-surface/20 hover:border-primary pb-px">
              {team.name}
            </a>
          ))}
        </div>
      </section>

      <!-- Teams Detail -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-32">
        {teams.map(team => (
          <div id={team.name.toLowerCase()} class="space-y-4">
            <h3 class="text-2xl font-bold">{team.name}</h3>
            <p class="text-on-surface-variant leading-relaxed">
              {team.description}
            </p>
          </div>
        ))}
      </section>

      <!-- Featured Project -->
      {featuredResearch && (
        <section class="mb-32">
          <a href={`/research/${featuredResearch.slug}`} class="group space-y-10 group">
             {featuredResearch.image ? (
               <div class="aspect-[21/9] bg-surface rounded-2xl overflow-hidden border border-outline relative">
                 <img src={featuredResearch.image} alt={featuredResearch.title} class="w-full h-full object-cover grayscale opacity-60 transition-all duration-700 group-hover:grayscale-0 group-hover:opacity-100" />
                 <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-center space-y-2">
                      <span class="text-sm font-mono uppercase tracking-[0.3em] text-primary">Featured Research</span>
                      <h2 class="text-4xl md:text-6xl font-bold tracking-tighter">{featuredResearch.title.split(':')[0]}</h2>
                    </div>
                 </div>
               </div>
             ) : (
               <div class="aspect-[21/9] bg-surface-accent rounded-2xl border border-outline border-dashed flex flex-col items-center justify-center gap-4 group-hover:border-primary/40 transition-colors">
                  <span class="text-sm font-mono uppercase tracking-[0.3em] text-primary">Research Spotlight</span>
                  <h2 class="text-3xl md:text-5xl font-bold text-center px-6">{featuredResearch.title}</h2>
               </div>
             )}
             
             <div class="grid md:grid-cols-4 gap-8">
               <div class="text-sm font-bold uppercase tracking-widest text-on-surface-muted">
                 Research <span class="mx-2">•</span> {new Date(featuredResearch.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
               </div>
               <div class="md:col-span-3 space-y-4">
                 <h2 class="text-3xl font-bold group-hover:text-primary transition-colors">{featuredResearch.title}</h2>
                 <p class="text-lg text-on-surface-variant leading-relaxed">
                   {featuredResearch.excerpt}
                 </p>
               </div>
             </div>
          </a>
        </section>
      )}

      <!-- Publications -->
      <section class="space-y-12">
        <div class="flex items-center justify-between border-b border-outline pb-6">
          <h2 class="text-4xl font-bold">Publications</h2>
          <div class="relative w-72 hidden md:block">
            <Search size={18} class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-muted" />
            <input 
              type="text" 
              placeholder="Search papers..." 
              class="w-full bg-surface border border-outline rounded-full py-2 pl-10 pr-4 focus:outline-none focus:border-primary transition-colors text-sm"
            />
          </div>
        </div>

        <div class="space-y-16">
          {publications.map((paper) => (
             <article class="group">
               <a href={`/research/${paper.slug}`} class="grid grid-cols-1 md:grid-cols-4 gap-4">
                 <div class="text-sm font-mono text-on-surface-muted pt-1">
                   {paper.category} <span class="mx-1">•</span> {new Date(paper.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                 </div>
                 <div class="md:col-span-3 space-y-2">
                   <h3 class="text-2xl font-bold group-hover:text-primary transition-colors leading-snug">
                     {paper.title}
                   </h3>
                   <p class="text-on-surface-variant leading-relaxed line-clamp-2 italic font-light">
                     {paper.excerpt}
                   </p>
                 </div>
               </a>
             </article>
          ))}
        </div>

        <div class="flex justify-center pt-12">
          <button class="premium-button premium-button-secondary px-12 group">
            See more
            <ArrowRight size={16} class="group-hover:translate-x-1 transition-transform" />
          </button>
        </div>
      </section>

      <!-- CTA -->
      <section class="mt-40 rounded-[2rem] bg-surface-accent border border-outline p-12 md:p-20 text-center relative overflow-hidden group">
        <div class="absolute inset-0 grid-bg opacity-10"></div>
        <div class="relative z-10 space-y-8">
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight">Join the Research team</h2>
          <button class="premium-button premium-button-primary px-8 py-4 text-lg">
            See open roles
            <ArrowRight size={20} />
          </button>
        </div>
      </section>

    </main>
  </div>
</MainLayout>
