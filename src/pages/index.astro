---
import MainLayout from '../layouts/MainLayout.astro';
import AxeroHero3D from '../components/AxeroHero3D';
import StatsStrip from '../components/StatsStrip';
import HomeNews from '../components/HomeNews';
import HomeResearch from '../components/HomeResearch';
import Capabilities from '../components/Capabilities';
import Methodology from '../components/Methodology';
import Vision from '../components/Vision';
import PublicationHighlights from '../components/PublicationHighlights';
import LabsWorkspace from '../components/LabsWorkspace';
import FinalCTA from '../components/FinalCTA';
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import PremiumCard from '../components/PremiumCard';
import MotionSection from '../components/MotionSection';

import projectsData from '../data/projects.json';
import IconRenderer from '../components/IconRenderer';

const featuredProjects = projectsData
  .filter(p => p.featured)
  .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  .slice(0, 4);

const labs = (await getCollection('labs'))
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .slice(0, 6);
---

<MainLayout title="Systems Intelligence & Cognitive Infrastructure" description="AxeroAI architects high-fidelity autonomous infrastructure and intelligent ecosystems for a decentralized future.">
	<main class="relative bg-background overflow-hidden">
    <!-- Immersive Background Layers -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
       <div class="absolute top-[10%] -left-[10%] w-[40%] h-[40%] bg-primary/2 rounded-full blur-[200px] animate-pulse-slow"></div>
       <div class="absolute bottom-[20%] -right-[10%] w-[50%] h-[50%] bg-primary/5 rounded-full blur-[240px] animate-pulse-slow [animation-delay:2s]"></div>
    </div>

    <AxeroHero3D client:load />

    <!-- 2. Trust Bar -->
    <MotionSection client:visible direction="down" delay={0.2} className="border-y border-outline py-10 bg-surface/20 backdrop-blur-md overflow-hidden relative z-10">
      <div class="max-w-7xl mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center gap-10 md:gap-20">
        <span class="font-mono text-[9px] text-on-surface-muted uppercase tracking-[0.3em] whitespace-nowrap">Integrated with frontier frameworks</span>
        <div class="flex overflow-hidden relative group w-full opacity-40 hover:opacity-80 transition-opacity">
           <div class="animate-scroll flex whitespace-nowrap gap-16 md:gap-24 items-center">
            {['OpenAI Protocol', 'Anthropic Hub', 'Mistral Core', 'Meta Systems', 'Google Cloud', 'NVIDIA Bio', 'Oracle AI'].map((name) => (
              <span class="text-xl md:text-2xl font-display font-black text-white hover:text-primary transition-all cursor-default tracking-tighter uppercase whitespace-nowrap">
                {name}
              </span>
            ))}
            {['OpenAI Protocol', 'Anthropic Hub', 'Mistral Core', 'Meta Systems', 'Google Cloud', 'NVIDIA Bio', 'Oracle AI'].map((name) => (
              <span class="text-xl md:text-2xl font-display font-black text-white hover:text-primary transition-all cursor-default tracking-tighter uppercase whitespace-nowrap">
                {name}
              </span>
            ))}
          </div>
        </div>
      </div>
    </MotionSection>

    <!-- 3. Stats Strip -->
    <StatsStrip client:visible />

    <!-- 3.5 Latest Intelligence (News) -->
    <HomeNews client:visible />

    <!-- 3.7 Research Frontiers -->
    <HomeResearch client:visible />

    <!-- 4. Core Capabilities -->
    <Capabilities client:visible />

    <!-- 5. Featured Projects (Enhanced Product Section) -->
    <section id="projects" class="py-24 md:py-40 relative z-10">
      <div class="max-w-7xl mx-auto px-6 md:px-10">
        <header class="mb-16 md:mb-24 flex flex-col lg:flex-row lg:items-end justify-between gap-6 md:gap-10">
           <div class="space-y-4 md:space-y-6">
              <div class="section-label">Selected Projects</div>
              <h2 class="text-4xl sm:text-5xl md:text-8xl font-extrabold tracking-tighter leading-none">Featured Projects</h2>
           </div>
           <a href="/projects" class="group flex items-center gap-2 text-on-surface-variant hover:text-white transition-all text-sm font-medium">
              View All Projects
              <ArrowRight size={20} className="transition-transform group-hover:translate-x-1" />
           </a>
        </header>

        <div class="grid lg:grid-cols-12 gap-6 md:gap-8">
          {featuredProjects.slice(0, 1).map(project => (
            <div class="lg:col-span-8 group">
               <PremiumCard client:visible className="p-0 !bg-transparent border-0 ring-1 ring-outline hover:ring-primary/50 !rounded-[2rem] md:!rounded-[2.5rem] h-full overflow-hidden">
                  <div class="grid md:grid-cols-2 h-full">
                     <div class="p-8 md:p-12 lg:p-16 flex flex-col justify-between space-y-8 md:space-y-12 h-full">
                        <div class="space-y-6 md:space-y-8">
                           <div class="flex flex-wrap items-center gap-4">
                              <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
                                 <IconRenderer client:load iconName={project.iconName} size={28} />
                              </div>
                              <span class="font-mono text-[10px] text-primary border border-primary/30 bg-primary/5 px-4 py-1.5 rounded-full uppercase tracking-widest font-bold">{project.status}</span>
                           </div>
                           <h3 class="text-3xl md:text-5xl font-extrabold tracking-tight">{project.title}</h3>
                           <p class="text-lg md:text-xl text-on-surface-variant font-light leading-relaxed">{project.shortDescription}</p>
                        </div>
                        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 md:gap-8 pt-8 border-t border-outline">
                           <a href={`/projects/${project.slug}`} class="premium-button premium-button-primary px-8 w-full sm:w-auto text-center">View Project</a>
                           <div class="flex flex-wrap gap-3 md:gap-4">
                              {project.tags.slice(0, 3).map(t => (
                                <span class="font-mono text-[10px] text-on-surface-muted uppercase">{t}</span>
                              ))}
                           </div>
                        </div>
                     </div>
                     <div class="bg-surface-accent relative overflow-hidden h-full min-h-[300px] md:min-h-[400px]">
                        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent"></div>
                        <div class="absolute inset-0 flex items-center justify-center text-primary/10 group-hover:text-primary transition-all duration-1000">
                           <IconRenderer client:load iconName={project.iconName} size={160} className="grayscale opacity-20 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110" />
                        </div>
                     </div>
                  </div>
               </PremiumCard>
            </div>
          ))}

          <div class="lg:col-span-4 flex flex-col gap-6 md:gap-8">
             {featuredProjects.slice(1, 4).map((project, i) => (
                <PremiumCard client:visible className="flex-1 group !rounded-[2rem]">
                   <div class="space-y-6 md:space-y-8">
                      <div class="flex justify-between items-start">
                         <div class="w-12 h-12 rounded-xl bg-surface-accent flex items-center justify-center text-primary border border-outline">
                            <IconRenderer client:load iconName={project.iconName} size={24} />
                         </div>
                         <span class="font-mono text-[10px] text-orange-400 border border-orange-400/30 bg-orange-400/5 px-2.5 py-0.5 rounded-full uppercase tracking-widest font-bold">{project.status}</span>
                      </div>
                      <h3 class="text-xl md:text-2xl font-bold">{project.title}</h3>
                      <p class="text-sm text-on-surface-variant font-light leading-relaxed line-clamp-2 italic">"{project.shortDescription}"</p>
                      <div class="pt-6 border-t border-outline flex items-center justify-between">
                         <a href={`/projects/${project.slug}`} class="text-xs font-mono text-primary uppercase tracking-widest flex items-center gap-2 group-hover:translate-x-1 transition-transform">
                            Details <ArrowUpRight size={14} />
                         </a>
                      </div>
                   </div>
                </PremiumCard>
             ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Vision (Thesis) -->
    <Vision client:load />

    <!-- 7. Labs (Foundry) -->
    <section id="labs" class="py-40 bg-surface/30 backdrop-blur-xl border-y border-outline relative overflow-hidden">
       <div class="grid-bg opacity-30"></div>
       <div class="max-w-7xl mx-auto px-6 md:px-10 relative z-10">
          <div class="grid lg:grid-cols-2 gap-32 items-start">
             <div class="space-y-10 lg:sticky lg:top-40">
                <div class="section-label">Cognitive Foundry</div>
                <h2 class="text-5xl md:text-8xl font-extrabold tracking-tighter leading-none">Axero Labs.</h2>
                <p class="text-2xl text-on-surface-variant font-light leading-relaxed max-w-lg">
                   Our experimental unit for pure technical risk. Exploring the edge case, the unproven, and the frontier of neural execution.
                </p>
                <div class="p-8 border border-outline bg-background/50 rounded-2xl border-l-[6px] border-l-primary shadow-2xl">
                   <p class="text-xs font-mono text-on-surface-variant leading-relaxed uppercase tracking-wider">
                      ⚠️ WARNING: THE FOLLOWING PROJECTS ARE ACTIVE EXPERIMENTS. PROTOCOLS ARE UNSTABLE AND SUBJECT TO TOTAL REDESIGN.
                   </p>
                </div>
                <a href="/labs" class="premium-button premium-button-primary px-10 py-5">
                  Access Workbench
                </a>
             </div>

             <LabsWorkspace client:visible labs={labs} />
          </div>
       </div>
    </section>

    <!-- 8. Methodology -->
    <Methodology client:visible />

    <!-- 9. Publications Highights -->
    <PublicationHighlights client:visible />

    <!-- 11. Final CTA (Immersive) -->
    <FinalCTA client:visible />

	</main>
</MainLayout>

<style>
  .animate-scroll {
    animation: scroll 40s linear infinite;
  }
</style>
