---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { ArrowUpRight } from 'lucide-react';

const products = await getCollection('products');
---

<MainLayout title="Products & Ecosystem" description="Discover the intelligent stack powering modern digital infrastructure.">
  <div class="pt-32 pb-24 px-6 bg-[#050505]">
    <div class="max-w-7xl mx-auto">
      <header class="mb-24 text-center max-w-3xl mx-auto space-y-8">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-full text-white text-[10px] font-mono uppercase tracking-[0.3em] font-black">
          Intelligence Units
        </div>
        <h1 class="text-6xl md:text-8xl font-black premium-gradient-text tracking-tighter leading-none">The Stack.</h1>
        <p class="text-xl text-zinc-500 font-light leading-relaxed max-w-2xl mx-auto">
          High-performance autonomous systems engineered for complexity at global scale.
        </p>
      </header>

      <div class="grid lg:grid-cols-2 gap-12">
        {products.map((product) => (
          <div class="premium-card group relative p-0 overflow-hidden flex flex-col border-white/5 bg-zinc-950/50">
            <div class="aspect-video relative grayscale hover:grayscale-0 transition-all duration-1000">
               {product.data.image && (
                <img src={product.data.image} alt={product.data.title} class="w-full h-full object-cover group-hover:scale-110 transition-all duration-1000 opacity-60 group-hover:opacity-100" />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
            </div>
            
            <div class="p-10 space-y-8 relative -mt-24 flex-grow bg-zinc-950/90 backdrop-blur-3xl mx-6 mb-6 rounded-[2rem] border border-white/5 group-hover:border-white/20 transition-all shadow-2xl">
              <div class="flex items-center justify-between">
                 <span class="text-[10px] font-mono text-zinc-500 font-black uppercase tracking-[0.3em]">{product.data.category}</span>
                 <div class="px-3 py-1 rounded-full text-[9px] font-mono border border-white/10 bg-white/5 uppercase tracking-widest text-white font-black animate-pulse">
                   {product.data.status}
                 </div>
              </div>
              
              <h3 class="text-4xl font-bold transition-colors text-white">{product.data.title}</h3>
              <p class="text-zinc-500 font-light leading-relaxed text-base">{product.data.description}</p>
              
              <div class="flex flex-wrap gap-2 pt-4">
                {product.data.tech.map(t => (
                  <span class="text-[9px] font-mono px-3 py-1.5 bg-white/5 border border-white/5 text-zinc-400 uppercase tracking-widest rounded-lg font-black transition-colors hover:text-white hover:bg-white/10">{t}</span>
                ))}
              </div>

               <div class="pt-10 mt-4 border-t border-white/5 flex items-center justify-between">
                <a href={`/products/${product.id}`} class="text-xs font-black uppercase tracking-[0.3em] text-white hover:opacity-70 transition-all inline-flex items-center gap-3 group/link">
                  Open Stack <ArrowUpRight size={16} className="group-hover:translate-x-1 group-hover:-translate-y-1 transition-all" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
