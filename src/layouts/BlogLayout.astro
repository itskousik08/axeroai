---
import MainLayout from './MainLayout.astro';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  image?: string;
  author: string;
}

const { title, description, publishDate, category, image, author } = Astro.props;
---

<MainLayout title={title} description={description} image={image} type="article">
  <article class="pt-32 pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <header class="mb-12 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-primary text-xs font-mono uppercase tracking-widest mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
          {category}
        </div>
        
        <h1 class="text-4xl md:text-6xl font-extrabold mb-8 premium-gradient-text leading-tight">
          {title}
        </h1>
        
        <div class="flex items-center justify-center gap-6 text-on-surface-variant text-sm font-medium">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-surface border border-outline flex items-center justify-center text-[10px] text-primary">
              AI
            </div>
            <span>{author}</span>
          </div>
          <div class="w-1 h-1 rounded-full bg-outline"></div>
          <time datetime={publishDate.toISOString()}>
            {formatDate(publishDate)}
          </time>
        </div>
      </header>

      <!-- Featured Image -->
      {image && (
        <div class="mb-16 aspect-video rounded-3xl overflow-hidden border border-outline bg-surface relative group">
          <img 
            src={image} 
            alt={title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-background/40 to-transparent"></div>
        </div>
      )}

      <!-- Content -->
      <div class="prose prose-invert lg:prose-xl mx-auto">
        <slot />
      </div>

      <!-- Footer / Share -->
      <footer class="mt-24 pt-12 border-t border-outline">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
          <div>
            <h4 class="text-on-background font-bold mb-2">The Intelligence Brief</h4>
            <p class="text-on-surface-variant text-sm">Insights on AI products and future tools.</p>
          </div>
          <div class="flex gap-4">
            <a href="/blog" class="premium-button premium-button-secondary text-sm">
              Back to Blog
            </a>
          </div>
        </div>
      </footer>
    </div>
  </article>
</MainLayout>
