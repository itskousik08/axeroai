---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import { Calendar, Tag, ChevronLeft, Clock } from 'lucide-react';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<MainLayout title={entry.data.title} description={entry.data.description}>
  <article class="pt-32 pb-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/news" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-900 mb-12 transition-colors group">
        <ChevronLeft className="w-4 h-4 mr-1 group-hover:-translate-x-1 transition-transform" />
        Back to News
      </a>

      <header class="mb-12">
        <div class="flex items-center space-x-4 mb-6">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#4F46E5]/10 text-[#4F46E5] border border-[#4F46E5]/20">
            <Tag className="w-3 h-3 mr-1" />
            {entry.data.category}
          </span>
          <span class="flex items-center text-xs text-gray-500">
            <Calendar className="w-3 h-3 mr-1" />
            {entry.data.date}
          </span>
          {entry.data.readTime && (
            <span class="flex items-center text-xs text-gray-500">
              <Clock className="w-3 h-3 mr-1" />
              {entry.data.readTime}
            </span>
          )}
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 leading-tight mb-8">
          {entry.data.title}
        </h1>
        
        <div class="flex items-center space-x-4 mb-12 pb-8 border-b border-gray-200">
          {entry.data.author && (
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-full bg-[#4F46E5]/10 flex items-center justify-center text-xs font-bold text-[#4F46E5]">
                {entry.data.author.split(' ').map(n => n[0]).join('')}
              </div>
              <div>
                <div class="text-sm font-bold text-gray-900">{entry.data.author}</div>
                <div class="text-xs text-gray-500">Research Team</div>
              </div>
            </div>
          )}
        </div>

        <div class="aspect-[21/9] rounded-3xl overflow-hidden border border-gray-200 mb-12">
          <img src={entry.data.image} alt={entry.data.title} class="w-full h-full object-cover" referrerPolicy="no-referrer" />
        </div>
      </header>

      <div class="prose prose-lg prose-indigo max-w-none prose-headings:font-bold prose-p:text-gray-600 prose-p:leading-relaxed prose-a:text-[#4F46E5] prose-strong:text-gray-900 prose-img:rounded-2xl">
        <Content />
      </div>
    </div>
  </article>
</MainLayout>
