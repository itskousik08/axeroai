---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { formatDate } from '../../lib/utils';
import { ArrowRight } from 'lucide-react';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const featuredPost = posts.find(p => p.data.featured) || posts[0];
const remainingPosts = posts.filter(p => p.id !== featuredPost?.id);
---

<MainLayout title="Blog & Insights" description="Deep dives into AI strategy, production engineering, and digital tools.">
  <div class="pt-32 pb-24 px-6">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <header class="mb-20">
        <h1 class="text-5xl md:text-7xl font-extrabold mb-6 premium-gradient-text">Our Insights</h1>
        <p class="text-xl text-on-surface-variant max-w-2xl font-light">
          Editorial perspectives on the intersection of artificial intelligence and physical systems.
        </p>
      </header>

      {featuredPost && (
        <section class="mb-24">
          <a href={`/blog/${featuredPost.id}`} class="group grid lg:grid-cols-2 gap-12 items-center premium-card">
            <div class="aspect-video rounded-xl overflow-hidden bg-surface relative grayscale group-hover:grayscale-0 transition-all duration-700">
              {featuredPost.data.image && (
                <img src={featuredPost.data.image} alt={featuredPost.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700" />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-background/60 to-transparent"></div>
            </div>
            <div class="space-y-6">
              <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-primary text-xs font-mono uppercase tracking-widest">
                <span>Featured</span>
              </div>
              <h2 class="text-3xl md:text-5xl font-bold group-hover:text-primary transition-colors leading-tight">
                {featuredPost.data.title}
              </h2>
              <p class="text-on-surface-variant text-lg line-clamp-3 font-light leading-relaxed">
                {featuredPost.data.description}
              </p>
              <div class="flex items-center gap-4 text-sm font-mono text-on-surface-variant uppercase tracking-widest pt-4">
                <span>{formatDate(featuredPost.data.publishDate)}</span>
                <span class="w-1 h-1 rounded-full bg-outline"></span>
                <span>{featuredPost.data.category}</span>
              </div>
            </div>
          </a>
        </section>
      )}

      <!-- Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {remainingPosts.map((post) => (
          <a href={`/blog/${post.id}`} class="premium-card group flex flex-col h-full">
            <div class="aspect-video rounded-xl overflow-hidden bg-surface mb-6 relative grayscale group-hover:grayscale-0 transition-all duration-700">
               {post.data.image && (
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700" />
              )}
              <div class="absolute inset-0 bg-black/10"></div>
            </div>
            <div class="flex-grow space-y-4">
              <div class="flex items-center justify-between text-[10px] font-mono text-on-surface-variant uppercase tracking-widest mb-2">
                <span>{post.data.category}</span>
                <span>{formatDate(post.data.publishDate)}</span>
              </div>
              <h3 class="text-xl font-bold group-hover:text-primary transition-colors leading-snug">
                {post.data.title}
              </h3>
              <p class="text-on-surface-variant text-sm line-clamp-3 font-light leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="pt-6 mt-6 border-t border-outline flex items-center justify-between group">
              <span class="text-xs font-bold uppercase tracking-widest text-on-surface-variant group-hover:text-primary transition-colors">Read Article</span>
              <ArrowRight size={16} class="text-on-surface-variant group-hover:text-primary group-hover:translate-x-1 transition-all" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
